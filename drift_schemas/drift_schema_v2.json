  "fixed_sql": [
    {
      "name": "patients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"patients\" (\"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'pending', \"local_updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"family_id\" TEXT NULL, \"user_id\" TEXT NULL, \"name\" TEXT NOT NULL, \"birth_year\" INTEGER NULL, \"conditions\" TEXT NOT NULL DEFAULT '[]', \"notes\" TEXT NULL, \"photo_path\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "medications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medications\" (\"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'pending', \"local_updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"patient_id\" TEXT NOT NULL REFERENCES patients (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"strength\" TEXT NULL, \"form\" TEXT NULL CHECK (form IN ('tablet','kapsul','sirup','tetes','salep','injeksi','inhaler','lainnya')), \"instructions\" TEXT NULL, \"meal_relation\" TEXT NULL CHECK (meal_relation IN ('sebelum_makan','sesudah_makan','bersama_makan','bebas')), \"prescribed_by\" TEXT NULL, \"stock_qty\" REAL NULL, \"dose_qty\" REAL NOT NULL DEFAULT 1.0, \"refill_threshold_days\" INTEGER NOT NULL DEFAULT 3, \"photo_path\" TEXT NULL, \"photo_remote_path\" TEXT NULL, \"start_date\" INTEGER NOT NULL, \"end_date\" INTEGER NULL, \"is_prn\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_prn\" IN (0, 1)), \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"source\" TEXT NOT NULL DEFAULT 'manual', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schedules\" (\"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'pending', \"local_updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"medication_id\" TEXT NOT NULL REFERENCES medications (id) ON DELETE CASCADE, \"times\" TEXT NOT NULL, \"days_of_week\" TEXT NOT NULL DEFAULT '[1,2,3,4,5,6,7]', \"timezone\" TEXT NOT NULL DEFAULT 'Asia/Jakarta', \"grace_minutes\" INTEGER NOT NULL DEFAULT 30, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "dose_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dose_logs\" (\"id\" TEXT NOT NULL, \"schedule_id\" TEXT NOT NULL REFERENCES schedules (id) ON DELETE CASCADE, \"patient_id\" TEXT NOT NULL REFERENCES patients (id) ON DELETE CASCADE, \"scheduled_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"confirmed_by\" TEXT NULL, \"confirmed_at\" INTEGER NULL, \"source\" TEXT NOT NULL DEFAULT 'device', \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'pending', PRIMARY KEY (\"id\"), UNIQUE (\"schedule_id\", \"scheduled_at\", \"status\"));"
        }
      ]
    },
    {
      "name": "sync_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_queue\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"target_table\" TEXT NOT NULL, \"row_id\" TEXT NOT NULL, \"op\" TEXT NOT NULL, \"payload_json\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "scheduled_notifications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"scheduled_notifications\" (\"notification_id\" INTEGER NOT NULL, \"schedule_id\" TEXT NOT NULL, \"scheduled_at\" INTEGER NOT NULL, PRIMARY KEY (\"notification_id\"));"
        }
      ]
    },
