          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_cursor\" (\"target_table\" TEXT NOT NULL, \"last_pulled_at\" INTEGER NOT NULL, PRIMARY KEY (\"target_table\"));"
        }
      ]
    }
